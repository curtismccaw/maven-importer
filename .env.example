# Copy this file to .env and fill in real values. Never commit .env.
# After ANY edit to .env, fully stop and restart the server — Node only
# reads .env once, at startup.

# Anthropic API key, used server-side only for AI mapping suggestions,
# content enrichment, and colour simplification.
ANTHROPIC_API_KEY=sk-ant-...

# --- Shopify ---
# SHOPIFY_STORE_DOMAIN: the bare *.myshopify.com hostname, nothing else.
# No https://, no trailing slash, and — easy mistake if pasting from
# somewhere that rendered it as a clickable link — no markdown link syntax
# like [text](url). Just: maventest-hcpd88pt.myshopify.com
SHOPIFY_STORE_DOMAIN=maventest-hcpd88pt.myshopify.com

# Shopify deprecated static shpat_ tokens for custom apps as of January 1.
# Apps created in the current Dev Dashboard (dev.shopify.com) no longer show
# a token to copy anywhere — only a Client ID and Client Secret (the secret
# is in shpss_ format). Use THOSE, as SHOPIFY_API_KEY / SHOPIFY_API_SECRET
# below: the app exchanges them for a short-lived access token automatically
# and refreshes it before it expires (~every 24h). This is the path almost
# everyone needs now.
SHOPIFY_API_KEY=your-client-id
SHOPIFY_API_SECRET=your-client-secret

# Only set this instead of the two above if you have an OLDER, admin-created
# custom app from before the January 1 change — those still have a working
# static token. Leave it unset/commented out otherwise; if both this and
# API_KEY/SECRET are set, this one wins.
# SHOPIFY_ACCESS_TOKEN=shpat_...

SHOPIFY_API_VERSION=2024-10

# Minimum milliseconds between Shopify pushes (protects against hitting the
# Admin API's rate limits when pushing many products or several people push
# at once). 0 or unset disables throttling.
PUSH_INTERVAL_MS=600

# Port the Express server listens on. In production this also serves the built frontend.
PORT=3000
