# Copy this file to .env and fill in real values. Never commit .env.

# Shopify Admin API
# Create a custom app in the target store (Settings > Apps > Develop apps),
# grant it write_products / write_inventory scopes, and install it.
# This must be the SANDBOX store's credentials while testing, and swapped to
# the live store's credentials only when Maven is ready.
SHOPIFY_STORE_DOMAIN=maventest-hcpd88pt.myshopify.com

# Custom apps created since Shopify's Jan 2026 change only issue a Client ID
# and Client secret (no static admin token) — the app exchanges these for a
# short-lived access token at runtime. Set both:
SHOPIFY_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_SECRET=shpss_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Older custom apps that still show a static "Admin API access token"
# (shpat_...) can set this instead and skip SHOPIFY_API_KEY/SECRET above.
# SHOPIFY_ADMIN_API_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

SHOPIFY_API_VERSION=2025-01

# Anthropic API (used only for the optional AI-assisted column mapping step)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Server
PORT=3000

# Required only if you upload a zip of images for &Tradition/Moebe/FRAMA
# (see brand-mapping-notes.md — these brands have no usable image feed and
# rely on a zip matched by SKU). Must be this app's real, publicly reachable
# URL once deployed — Shopify fetches images from here, so localhost will
# not work. Leave blank while testing brands that don't need it.
# Example: https://maven-importer.onrender.com
PUBLIC_BASE_URL=

# Push behaviour
# Products per second sent to Shopify. Shopify's GraphQL Admin API uses a
# cost-based leaky bucket rather than a strict RPS cap, but throttling pushes
# to roughly one every 600ms keeps this well clear of 429s without needing
# to inspect the cost extension on every response.
PUSH_INTERVAL_MS=600
