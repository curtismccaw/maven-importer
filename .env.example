# Copy this file to .env and fill in real values. Never commit .env.

# Anthropic API key, used server-side only for AI mapping suggestions and content enrichment.
ANTHROPIC_API_KEY=sk-ant-...

# Shopify Admin API access token for the target store (sandbox by default).
SHOPIFY_STORE_DOMAIN=maventest-hcpd88pt.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_...
SHOPIFY_API_VERSION=2024-10

# Port the Express server listens on. In production this also serves the built frontend.
PORT=3000
